# Required: directory containing all initialized llm-wiki workspaces.
WORKSPACES_ROOT=/absolute/path/to/workspaces

# Required in production: bearer token expected by the MCP server.
# Generate one with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional service settings.
DOCUMENTS_MCP_PORT=3337
DOCUMENT_INPUT_HOST_DIR=./documents/input
DOCUMENT_OUTPUT_HOST_DIR=./documents/output
DOCUMENT_MAX_UPLOAD_BYTES=52428800
INDRA_OCR_THREADS=4

# Markdown polishing reuses the selected workspace's .wikirc.yaml LLM profile.
# No separate LLM environment variables are needed.
